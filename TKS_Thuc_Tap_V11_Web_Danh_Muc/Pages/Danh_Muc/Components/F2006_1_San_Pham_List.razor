@inherits FBase;

@Layout_Default_Filter(grdData, "")

<div class="row" style="padding-top: 10px;">
    <div class="col-lg-12">
        @((MarkupString)r_strError)

        <TelerikGrid Data="@v_arrData" Height="calc(100vh - 170px)" Resizable="true" Reorderable="true" @ref="@grdData">
            <GridExport>
                <GridExcelExport FileName="San_Pham_Export" AllPages="true" />
                <GridCsvExport FileName="San_Pham_Export" AllPages="true" />
            </GridExport>
            <GridColumns>
                <GridCheckboxColumn SelectAll="true" CheckBoxOnlySelection="true" Width="30px"></GridCheckboxColumn>
                <GridColumn Width="60px">
                    <Template>
                        <button class="btn btn-link" @onclick="@(() => Open_Info((context as CDM_San_Pham).Auto_ID))">
                            <i class="mdi mdi-eye" style="color: purple;"></i>
                        </button>
                        <button class="btn btn-link" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="mdi mdi-cog-outline" style="color: purple;"></i>
                        </button>
                        <ul class="dropdown-menu">
                            @if (r_objChuc_Nang.Is_Have_Edit_Permission)
                            {
                                <li>
                                    <button class="dropdown-item" type="button" @onclick="@(() => Open_Edit((context as CDM_San_Pham).Auto_ID))">
                                        <i class="ri-edit-2-line align-bottom me-1"></i> @Get_Language_Data_Field("Hiệu chỉnh")
                                    </button>
                                </li>
                            }
                            @if (r_objChuc_Nang.Is_Have_Delete_Permission)
                            {
                                <li>
                                    <button class="dropdown-item" type="button" @onclick="@(() => Delete_Data((context as CDM_San_Pham).Auto_ID))">
                                        <i class="ri-delete-bin-line align-bottom me-1"></i> @Get_Language_Data_Field("Xóa")
                                    </button>
                                </li>
                            }
                        </ul>
                    </Template>
                </GridColumn>
                @if (CCache_Grid_UI_Global.List_Data_By_Code("2006", "grdData").Count > 0)
                {
                    <FCommon_General_Col_Grid m_strFCode="2006" m_strTen_Grid="grdData"></FCommon_General_Col_Grid>
                }
                else
                {
                    <GridColumn Field="Ma_San_Pham" Title="Mã sản phẩm" Width="160px"></GridColumn>
                    <GridColumn Field="Ten_San_Pham" Title="Tên sản phẩm" Width="240px"></GridColumn>
                    <GridColumn Field="Ten_LSP" Title="Loại sản phẩm" Width="200px"></GridColumn>
                    <GridColumn Field="Ten_Don_Vi_Tinh" Title="Đơn vị tính" Width="160px"></GridColumn>
                    <GridColumn Field="Ghi_Chu" Title="Ghi chú" Width="260px"></GridColumn>
                    <GridColumn Field="" Title=""></GridColumn>
                }
            </GridColumns>
        </TelerikGrid>
    </div>
</div>

@if (r_bIs_Show_Info)
{
    <F2006_2_San_Pham_Info r_iAuto_ID="@r_iAuto_ID" OnClose="@Close_Info"></F2006_2_San_Pham_Info>
}

@if (r_bIs_Show_Help_Guide)
{
    <FCommon_Help_Guide m_strFCode="@r_strActive_Function_Code" OnClose="@Close_Helpguide"></FCommon_Help_Guide>
}

@if (r_bIs_Show_Edit)
{
    <F2006_3_San_Pham_Edit r_iAuto_ID="@r_iAuto_ID" OnClose="@Close_Edit"></F2006_3_San_Pham_Edit>
}

@code {
    private List<CDM_San_Pham> v_arrData = new();
    private TelerikGrid<CDM_San_Pham> grdData = new();

    protected override void Load_Data()
    {
        Format_Grid(grdData);
        DateTime? v_dtmFrom = CUtility_Date.Convert_To_Dau_Ngay(r_objFilter.Date_From);
        DateTime? v_dtmTo = CUtility_Date.Convert_To_Cuoi_Ngay(r_objFilter.Date_To);
        v_arrData = new CDM_San_Pham_Controller().FQ_107_SP_sp_sel_List()
            .Where(v_objData => (!v_dtmFrom.HasValue || (v_objData.Created.HasValue && v_objData.Created >= v_dtmFrom))
                && (!v_dtmTo.HasValue || (v_objData.Created.HasValue && v_objData.Created <= v_dtmTo)))
            .ToList();
    }

    protected override void Delete_Data_Entry(long p_iAuto_ID)
    {
        CDM_San_Pham_Controller v_objCtrData = new();
        CDM_San_Pham v_objData = v_objCtrData.FQ_107_SP_sp_sel_Get_By_ID(p_iAuto_ID);
        if (v_objData != null)
            r_strDelete_Key = v_objData.Ma_San_Pham;

        v_objCtrData.FQ_107_SP_sp_del_Delete_By_ID(p_iAuto_ID, r_strActive_User_Name, r_strActive_Function_Code);
    }
}