@inherits FBase_Edit;

<div class="modal fade show" tabindex="-1" role="dialog" aria-hidden="true" style="display: block; padding-left: 0px; background-color: rgba(10, 10, 10, .8);">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title">@Get_Language_Data_Field(r_iAuto_ID == 0 ? "Thêm dòng sản phẩm" : "Hiệu chỉnh dòng sản phẩm")</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" @onclick="@(() => Modal_Cancel())"></button>
            </div>

            @((MarkupString)r_strError)

            <EditForm Model="@m_objData">
                <div class="modal-body">
                    @if (r_iAuto_ID == 0)
                    {
                        <div class="row mb-3">
                            <div class="col-lg-12">
                                <label class="form-label">@Get_Language_Data_Field("Mã sản phẩm"):</label>
                                <select @bind="m_objData.San_Pham_ID" class="form-select">
                                    <option value="0">-- @Get_Language_Data_Field("Chọn sản phẩm") --</option>
                                    @foreach (CDM_San_Pham v_objSan_Pham in m_arrSan_Pham)
                                    {
                                        <option value="@v_objSan_Pham.Auto_ID">@v_objSan_Pham.Ma_San_Pham - @v_objSan_Pham.Ten_San_Pham</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="row mb-3">
                            <div class="col-lg-12">
                                <label class="form-label">@Get_Language_Data_Field("Mã sản phẩm"):</label>
                                <input class="form-control" value="@m_objData.Ma_San_Pham" readonly />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-lg-12">
                                <label class="form-label">@Get_Language_Data_Field("Tên sản phẩm"):</label>
                                <input class="form-control" value="@m_objData.Ten_San_Pham" readonly />
                            </div>
                        </div>
                    }

                    <div class="row mb-3">
                        <div class="col-lg-6">
                            <label class="form-label">@Get_Language_Data_Field("Số lượng"):</label>
                            <input type="number" min="0.001" step="0.001" @bind="m_objData.SL_Nhap" class="form-control" />
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label">@Get_Language_Data_Field("Đơn giá"):</label>
                            <input type="number" min="0" step="0.01" @bind="m_objData.Don_Gia_Nhap" class="form-control" />
                        </div>
                    </div>
                    <div class="text-end"><strong>@Get_Language_Data_Field("Trị giá"):</strong> @((m_objData.SL_Nhap * m_objData.Don_Gia_Nhap).ToString("N2"))</div>
                </div>
            </EditForm>

            <div class="modal-footer">
                <button type="button" class="btn btn-primary" @onclick="@Save_Data">@Get_Language_Data_Field("Lưu thay đổi")</button>
            </div>
        </div>
    </div>
</div>

@code {
    private CDM_Nhap_Kho_Raw_Data m_objData = new();
    private List<CDM_San_Pham> m_arrSan_Pham = new();

    [Parameter]
    public long p_iNhap_Kho_ID { get; set; }

    [Parameter]
    public CDM_Nhap_Kho_Raw_Data p_objRaw_Data { get; set; }

    protected override void Load_Data()
    {
        m_arrSan_Pham = new CDM_San_Pham_Controller().FQ_107_SP_sp_sel_List();
        if (r_iAuto_ID == 0)
        {
            m_objData = new CDM_Nhap_Kho_Raw_Data { Nhap_Kho_ID = p_iNhap_Kho_ID, SL_Nhap = 1 };
            return;
        }

        if (p_objRaw_Data == null)
            throw new InvalidOperationException("Không tìm thấy dòng sản phẩm cần hiệu chỉnh.");

        m_objData = new CDM_Nhap_Kho_Raw_Data();
        CUtility.Clone_Entity(p_objRaw_Data, m_objData);
        m_objData.Nhap_Kho_ID = p_iNhap_Kho_ID;
        r_bUpdate = true;
        CDM_Nhap_Kho_Raw_Data v_objClone = new();
        CUtility.Clone_Entity(m_objData, v_objClone);
        r_objSource = v_objClone;
    }

    protected override void Add_Data()
    {
        Validate_Data();
        m_objData.Nhap_Kho_ID = p_iNhap_Kho_ID;
        CDM_San_Pham v_objProduct = m_arrSan_Pham.FirstOrDefault(v_objItem => v_objItem.Auto_ID == m_objData.San_Pham_ID);
        r_strAdd_Key = v_objProduct?.Ma_San_Pham ?? m_objData.San_Pham_ID.ToString();
        new CDM_Nhap_Kho_Controller().FQ_111_NK_sp_ins_Insert_Raw_Data(p_iNhap_Kho_ID, m_objData);
    }

    protected override void Update_Data()
    {
        Validate_Data();
        new CDM_Nhap_Kho_Controller().FQ_111_NK_sp_upd_Update_Raw_Data(m_objData);
        CDM_Nhap_Kho_Raw_Data v_objClone = new();
        CUtility.Clone_Entity(m_objData, v_objClone);
        r_objDes = v_objClone;
    }

    private void Validate_Data()
    {
        if (p_iNhap_Kho_ID <= 0)
            throw new InvalidOperationException("Phiếu nhập không hợp lệ.");
        if (r_iAuto_ID == 0 && m_objData.San_Pham_ID <= 0)
            throw new InvalidOperationException("Mã sản phẩm không được để trống.");
        if (m_objData.SL_Nhap <= 0)
            throw new InvalidOperationException("Số lượng phải lớn hơn 0.");
        if (m_objData.Don_Gia_Nhap < 0)
            throw new InvalidOperationException("Đơn giá không được nhỏ hơn 0.");
    }
}
