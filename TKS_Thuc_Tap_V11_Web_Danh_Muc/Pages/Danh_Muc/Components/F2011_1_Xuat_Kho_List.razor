@inherits FBase;

@Layout_Default_Filter(grdData, "")

<div class="row" style="padding-top: 10px;">
    <div class="col-lg-12">
        @((MarkupString)r_strError)

        <TelerikGrid Data="@v_arrData" Height="calc(100vh - 170px)" Resizable="true" Reorderable="true" @ref="@grdData">
            <GridExport>
                <GridExcelExport FileName="Xuat_Kho_Export" AllPages="true" />
                <GridCsvExport FileName="Xuat_Kho_Export" AllPages="true" />
            </GridExport>
            <GridColumns>
                <GridCheckboxColumn SelectAll="true" CheckBoxOnlySelection="true" Width="30px"></GridCheckboxColumn>
                <GridColumn Width="60px">
                    <Template>
                        <button class="btn btn-link" title="@Get_Language_Data_Field("Xem chi tiết")" @onclick="@(() => Open_Info((context as CDM_Xuat_Kho).Auto_ID))">
                            <i class="mdi mdi-eye" style="color: purple;"></i>
                        </button>
                        <button class="btn btn-link" data-bs-toggle="dropdown" aria-expanded="false" title="@Get_Language_Data_Field("Thao tác")">
                            <i class="mdi mdi-cog-outline" style="color: purple;"></i>
                        </button>
                        <ul class="dropdown-menu">
                            @if (r_objChuc_Nang.Is_Have_View_Permission)
                            {
                                <li>
                                    <button class="dropdown-item" type="button" @onclick="@(() => Open_Print((context as CDM_Xuat_Kho).Auto_ID))">
                                        <i class="ri-printer-line align-bottom me-1"></i> @Get_Language_Data_Field("In phiếu xuất")
                                    </button>
                                </li>
                            }
                            @if (r_objChuc_Nang.Is_Have_Edit_Permission)
                            {
                                <li>
                                    <button class="dropdown-item" type="button" @onclick="@(() => Open_Header_Edit((context as CDM_Xuat_Kho).Auto_ID))">
                                        <i class="ri-edit-2-line align-bottom me-1"></i> @Get_Language_Data_Field("Hiệu chỉnh thông tin phiếu")
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item" type="button" @onclick="@(() => Open_Detail_Edit((context as CDM_Xuat_Kho).Auto_ID))">
                                        <i class="ri-edit-line align-bottom me-1"></i> @Get_Language_Data_Field("Hiệu chỉnh chi tiết phiếu")
                                    </button>
                                </li>
                            }
                            @if (r_objChuc_Nang.Is_Have_Delete_Permission)
                            {
                                <li>
                                    <button class="dropdown-item" type="button" @onclick="@(() => Delete_Data((context as CDM_Xuat_Kho).Auto_ID))">
                                        <i class="ri-delete-bin-line align-bottom me-1"></i> @Get_Language_Data_Field("Xóa phiếu")
                                    </button>
                                </li>
                            }
                        </ul>
                    </Template>
                </GridColumn>
                @if (CCache_Grid_UI_Global.List_Data_By_Code("2011", "grdData").Count > 0)
                {
                    <FCommon_General_Col_Grid m_strFCode="2011" m_strTen_Grid="grdData"></FCommon_General_Col_Grid>
                }
                else
                {
                    <GridColumn Field="So_Phieu_Xuat_Kho" Title="Số phiếu xuất" Width="180px"></GridColumn>
                    <GridColumn Field="Ngay_Xuat_Kho" Title="Ngày xuất" Width="140px" DisplayFormat="{0:dd/MM/yyyy}"></GridColumn>
                    <GridColumn Field="Ten_Kho" Title="Kho" Width="180px"></GridColumn>
                    <GridColumn Field="So_Dong_Hang" Title="Số dòng" Width="100px"></GridColumn>
                    <GridColumn Field="Tong_Tien" Title="Tổng tiền" Width="160px" DisplayFormat="{0:N2}"></GridColumn>
                    <GridColumn Field="Ghi_Chu" Title="Ghi chú" Width="220px"></GridColumn>
                    <GridColumn Field="" Title=""></GridColumn>
                }
            </GridColumns>
        </TelerikGrid>
    </div>
</div>

@if (r_bIs_Show_Info)
{
    <F2011_2_Xuat_Kho_Info r_iAuto_ID="@r_iAuto_ID" OnClose="@Close_Info"></F2011_2_Xuat_Kho_Info>
}

@if (r_bIs_Show_Help_Guide)
{
    <FCommon_Help_Guide m_strFCode="@r_strActive_Function_Code" OnClose="@Close_Helpguide"></FCommon_Help_Guide>
}

@if (r_bIs_Show_Edit)
{
    <F2011_3_Xuat_Kho_Edit OnClose="@Close_Edit"></F2011_3_Xuat_Kho_Edit>
}

@if (m_bIs_Show_Header_Edit)
{
    <F2011_4_Xuat_Kho_Header_Edit r_iAuto_ID="@m_iHeader_Edit_ID" OnClose="@Close_Header_Edit"></F2011_4_Xuat_Kho_Header_Edit>
}

@if (m_bIs_Show_Detail_Edit)
{
    <F2011_6_Xuat_Kho_Edit_Detail r_iAuto_ID="@m_iDetail_Edit_ID" OnClose="@Close_Detail_Edit"></F2011_6_Xuat_Kho_Edit_Detail>
}

@if (m_bIs_Show_Print)
{
    <F2011_7_Xuat_Kho_Print r_iAuto_ID="@m_iPrint_ID" OnClose="@Close_Print"></F2011_7_Xuat_Kho_Print>
}

@code {
    private List<CDM_Xuat_Kho> v_arrData = new();
    private TelerikGrid<CDM_Xuat_Kho> grdData = new();
    private bool m_bIs_Show_Header_Edit;
    private long m_iHeader_Edit_ID;
    private bool m_bIs_Show_Detail_Edit;
    private long m_iDetail_Edit_ID;
    private bool m_bIs_Show_Print;
    private long m_iPrint_ID;

    protected override void Load_Data()
    {
        Format_Grid(grdData);
        DateTime? v_dtmFrom = CUtility_Date.Convert_To_Dau_Ngay(r_objFilter.Date_From);
        DateTime? v_dtmTo = CUtility_Date.Convert_To_Cuoi_Ngay(r_objFilter.Date_To);
        v_arrData = new CDM_Xuat_Kho_Controller().FQ_111_XK_sp_sel_List()
            .Where(v_objData => (!v_dtmFrom.HasValue || (v_objData.Created.HasValue && v_objData.Created >= v_dtmFrom))
                && (!v_dtmTo.HasValue || (v_objData.Created.HasValue && v_objData.Created <= v_dtmTo)))
            .ToList();
    }

    protected override void Delete_Data_Entry(long p_iAuto_ID)
    {
        CDM_Xuat_Kho v_objData = v_arrData.FirstOrDefault(v_objItem => v_objItem.Auto_ID == p_iAuto_ID);
        if (v_objData != null)
            r_strDelete_Key = v_objData.So_Phieu_Xuat_Kho;

        new CDM_Xuat_Kho_Controller().FQ_111_XK_sp_del_Delete_By_ID(p_iAuto_ID, r_strActive_User_Name, r_strActive_Function_Code);
    }

    private void Open_Header_Edit(long p_iAuto_ID)
    {
        m_iHeader_Edit_ID = p_iAuto_ID;
        m_bIs_Show_Header_Edit = true;
    }

    private void Close_Header_Edit(CEvent_Call_Back p_objEvent)
    {
        if (p_objEvent.Message_ID == (int)EModal_Result.Close_And_Reload_Data || p_objEvent.Message_ID == (int)EModal_Result.Close_Cancel)
            m_bIs_Show_Header_Edit = false;

        if (p_objEvent.Message_ID == (int)EModal_Result.Close_And_Reload_Data)
            Load_Data_Init();
    }

    private void Open_Detail_Edit(long p_iAuto_ID)
    {
        m_iDetail_Edit_ID = p_iAuto_ID;
        m_bIs_Show_Detail_Edit = true;
    }

    private void Close_Detail_Edit(CEvent_Call_Back p_objEvent)
    {
        if (p_objEvent.Message_ID == (int)EModal_Result.Close_And_Reload_Data || p_objEvent.Message_ID == (int)EModal_Result.Close_Cancel)
            m_bIs_Show_Detail_Edit = false;

        if (p_objEvent.Message_ID == (int)EModal_Result.Close_And_Reload_Data)
            Load_Data_Init();
    }

    private void Open_Print(long p_iAuto_ID)
    {
        m_iPrint_ID = p_iAuto_ID;
        m_bIs_Show_Print = true;
    }

    private void Close_Print(CEvent_Call_Back p_objEvent)
    {
        if (p_objEvent.Message_ID == (int)EModal_Result.Close_Cancel)
            m_bIs_Show_Print = false;
    }
}
