@inherits FBase;

@Layout_Default_Filter(grdData, "")

<div class="row" style="padding-top: 10px;">
    <div class="col-lg-12">
        @((MarkupString)r_strError)

        <TelerikGrid Data="@v_arrData" Height="calc(100vh - 170px)" Resizable="true" Reorderable="true" @ref="@grdData">
            <GridExport>
                <GridExcelExport FileName="Nha_Cung_Cap_Export" AllPages="true" />
                <GridCsvExport FileName="Nha_Cung_Cap_Export" AllPages="true" />
            </GridExport>
            <GridColumns>
                <GridCheckboxColumn SelectAll="true" CheckBoxOnlySelection="true" Width="30px"></GridCheckboxColumn>
                <GridColumn Width="60px">
                    <Template>
                        <button class="btn btn-link" @onclick="@(() => Open_Info((context as CDM_Nha_Cung_Cap).Auto_ID))">
                            <i class="mdi mdi-eye" style="color: purple;"></i>
                        </button>
                        <button class="btn btn-link" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="mdi mdi-cog-outline" style="color: purple;"></i>
                        </button>
                        <ul class="dropdown-menu">
                            @if (r_objChuc_Nang.Is_Have_Edit_Permission)
                            {
                                <li>
                                    <button class="dropdown-item" type="button" @onclick="@(() => Open_Edit((context as CDM_Nha_Cung_Cap).Auto_ID))">
                                        <i class="ri-edit-2-line align-bottom me-1"></i> @Get_Language_Data_Field("Hiệu chỉnh")
                                    </button>
                                </li>
                            }
                            @if (r_objChuc_Nang.Is_Have_Delete_Permission)
                            {
                                <li>
                                    <button class="dropdown-item" type="button" @onclick="@(() => Delete_Data((context as CDM_Nha_Cung_Cap).Auto_ID))">
                                        <i class="ri-delete-bin-line align-bottom me-1"></i> @Get_Language_Data_Field("Xóa")
                                    </button>
                                </li>
                            }
                        </ul>
                    </Template>
                </GridColumn>
                @if (CCache_Grid_UI_Global.List_Data_By_Code("2007", "grdData").Count > 0)
                {
                    <FCommon_General_Col_Grid m_strFCode="2007" m_strTen_Grid="grdData"></FCommon_General_Col_Grid>
                }
                else
                {
                    <GridColumn Field="Ma_NCC" Title="Mã nhà cung cấp" Width="180px"></GridColumn>
                    <GridColumn Field="Ten_NCC" Title="Tên nhà cung cấp" Width="260px"></GridColumn>
                    <GridColumn Field="Ghi_Chu" Title="Ghi chú" Width="300px"></GridColumn>
                    <GridColumn Field="" Title=""></GridColumn>
                }
            </GridColumns>
        </TelerikGrid>
    </div>
</div>

@if (r_bIs_Show_Info)
{
    <F2007_2_Nha_Cung_Cap_Info r_iAuto_ID="@r_iAuto_ID" OnClose="@Close_Info"></F2007_2_Nha_Cung_Cap_Info>
}

@if (r_bIs_Show_Help_Guide)
{
    <FCommon_Help_Guide m_strFCode="@r_strActive_Function_Code" OnClose="@Close_Helpguide"></FCommon_Help_Guide>
}

@if (r_bIs_Show_Edit)
{
    <F2007_3_Nha_Cung_Cap_Edit r_iAuto_ID="@r_iAuto_ID" OnClose="@Close_Edit"></F2007_3_Nha_Cung_Cap_Edit>
}

@code {
    private List<CDM_Nha_Cung_Cap> v_arrData = new();
    private TelerikGrid<CDM_Nha_Cung_Cap> grdData = new();

    protected override void Load_Data()
    {
        Format_Grid(grdData);
        DateTime? v_dtmFrom = CUtility_Date.Convert_To_Dau_Ngay(r_objFilter.Date_From);
        DateTime? v_dtmTo = CUtility_Date.Convert_To_Cuoi_Ngay(r_objFilter.Date_To);
        v_arrData = new CDM_Nha_Cung_Cap_Controller().FQ_108_NCC_sp_sel_List()
            .Where(v_objData => (!v_dtmFrom.HasValue || (v_objData.Created.HasValue && v_objData.Created >= v_dtmFrom))
                && (!v_dtmTo.HasValue || (v_objData.Created.HasValue && v_objData.Created <= v_dtmTo)))
            .ToList();
    }

    protected override void Delete_Data_Entry(long p_iAuto_ID)
    {
        CDM_Nha_Cung_Cap_Controller v_objCtrData = new();
        CDM_Nha_Cung_Cap v_objData = v_objCtrData.FQ_108_NCC_sp_sel_Get_By_ID(p_iAuto_ID);
        if (v_objData != null)
            r_strDelete_Key = v_objData.Ten_NCC;

        v_objCtrData.FQ_108_NCC_sp_del_Delete_By_ID(p_iAuto_ID, r_strActive_User_Name, r_strActive_Function_Code);
    }
}